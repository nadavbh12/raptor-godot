<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!--
      Exclude .godot scratch dir (mirrors raptor.csproj exclusion).
      Compile includes below pull only the sim source files we need.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.godot/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FsCheck.Xunit" Version="3.0.0" />
  </ItemGroup>
  <!--
    We reference the pre-built game DLL and GodotSharp directly rather
    than using a ProjectReference to raptor.csproj. A ProjectReference
    would pull in the Godot.NET.Sdk which requires the Godot editor build
    pipeline; a DLL reference keeps dotnet test self-contained.
    Build raptor first via: dotnet build raptor.csproj (or via Godot headless).

    The DLL paths are relative to this .csproj file (tests/).
  -->
  <ItemGroup>
    <Reference Include="raptor">
      <HintPath>../.godot/mono/temp/bin/Debug/raptor.dll</HintPath>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>../.godot/mono/temp/bin/Debug/GodotSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!--
    The referenced raptor.dll is NOT rebuilt by `dotnet test`, so edits under
    src/ stay invisible until raptor.csproj is rebuilt: the run then tests
    stale game code and reports a pass. Inputs/Outputs make MSBuild skip this
    target while the assembly is newer than every source file, and run it (so
    the Error fires) the moment any source is newer or the assembly is absent.
  -->
  <ItemGroup>
    <GameSource Include="../src/**/*.cs" />
  </ItemGroup>
  <Target Name="CheckGameAssemblyFreshness" BeforeTargets="CoreCompile"
          Inputs="@(GameSource)" Outputs="../.godot/mono/temp/bin/Debug/raptor.dll">
    <Error Text="raptor.dll is missing or older than src/ -- `dotnet test` does not rebuild the game assembly, so this run would test stale code. Run: dotnet build raptor.csproj" />
  </Target>

</Project>
