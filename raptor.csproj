<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Allow rolling forward to .NET 10+ when only newer runtimes are
         installed. Without this Godot Mono fails assembly load with
         ".NET: Assemblies not found" and crashes during startup
         (CSharpScript::reload). -->
    <RollForward>Major</RollForward>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Raptor</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      The default .NET SDK glob compiles every *.cs under the project root.
      Exclude:
        tests/**  — has its own RaptorTests.csproj with xUnit/FsCheck refs.
                    Compiling those files into the game assembly fails to
                    find xunit/Fact types.
        .godot/** — Godot editor scratch dir; regenerates AssemblyInfo.cs
                    that duplicates the one MSBuild auto-generates.
        tools/**  — standalone helper projects (e.g. tools/SimLint, the sim
                    discipline linter) carry their own csproj + Roslyn deps;
                    compiling their .cs into the game assembly would clash
                    (a second Main, refs the game doesn't have).
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.godot/**;tests/**;tools/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>RaptorTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
