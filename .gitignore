# Godot 4 .NET ignores
.godot/
.import/
build/
*.csproj.user
# Match all UID sidecars (Godot 4 emits them for scripts and may emit for
# scenes/resources in future minor versions).
*.uid

# .NET
bin/
obj/
*.dll.config

# IDE
.idea/
.vs/
.vscode/

# OS
.DS_Store
Thumbs.db

# Test artifacts
# Generated local parity/video artifacts.
dumps/
# C-play benchmark recordings (input/state/lossless video/audio — large, local-only).
benchmarks/
# Transient comparator outputs.
tests/parity_runs/
# Transient L7 screenshots.
tests/screenshots/
tests/.fsharp/
tests/__pycache__/
*.pyc
# Pilot save files written by the C binary or Godot during parity sweeps.
CHAR[0-9][0-9][0-9][0-9].FIL

# Held-out test materials never enter Git in a sealed scenario; for now we
# DO commit the held-out scripts and goldens (per spec §13a accepted risk),
# but keep this rule documented for future hardening:
# tests/scripts/holdout/
# tests/parity/scripts/holdout/
# tests/parity/seeds/holdout/

# Game data extracted from the original FILE0000.GLB / FILE0001.GLB.
# NOT redistributable — this repo ships no game content. Regenerate locally
# with tools/extract_assets.sh against your own copy of Raptor. See README.
assets/

# Local parity capture artifacts (screen recordings and smoke screenshots
# produced by parity/visual-diff runs; large and machine-specific).
*.mp4
smoke_*.png
raptor_parity_*.png

# Local agent/assistant state and generated docs.
.claude/
.superpowers/
AGENTS.md
docs/codebase-guide.html
